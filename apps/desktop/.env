# Production Convex deployment — self-hosted on Fly (infra/convex/fly.toml),
# no longer Convex Cloud. DEVICE_SECRET is NOT set here (this file is
# git-tracked); inject MAIN_VITE_DEVICE_SECRET at build time or via .env.local
# for a prod build.
#
# Self-hosted splits the old .cloud/.site hostname pair into two ports on one
# host: :443 is the API, :3211 is the HTTP-action router. The explicit port in
# the site URL is load-bearing — dropping it silently sends webhook and
# summarize traffic to the API port, which 404s.
MAIN_VITE_CONVEX_CLOUD_URL=https://orchestra-convex.fly.dev
MAIN_VITE_CONVEX_SITE_URL=https://orchestra-convex.fly.dev:3211
RENDERER_VITE_CONVEX_URL=https://orchestra-convex.fly.dev
